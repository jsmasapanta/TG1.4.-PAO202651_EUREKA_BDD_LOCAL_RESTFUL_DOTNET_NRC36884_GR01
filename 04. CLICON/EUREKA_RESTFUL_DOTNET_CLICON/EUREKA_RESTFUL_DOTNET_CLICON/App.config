<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!--
      Dirección del API REST (se arma http://RestHost:RestPuerto y las rutas api/eurekabank/...).
      Cambie RestHost por la IP de la PC del servidor (ipconfig) para trabajar en red.
      También se puede usar sin recompilar con las variables de entorno REST_HOST y REST_PORT,
      o cambiarlo desde la pantalla de login (opción S).
    -->
    <add key="RestHost" value="192.168.100.2" />
    <add key="RestPuerto" value="8088" />
  </appSettings>
</configuration>
