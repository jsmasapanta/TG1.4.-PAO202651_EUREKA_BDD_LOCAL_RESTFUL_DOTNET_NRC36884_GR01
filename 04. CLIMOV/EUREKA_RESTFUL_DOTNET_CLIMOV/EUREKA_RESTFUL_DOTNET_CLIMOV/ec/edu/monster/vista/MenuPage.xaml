<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.MenuPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Fondo}">

    <ScrollView>
        <VerticalStackLayout Padding="16,36,16,16" Spacing="16">

            <!-- Saludo con la foto, modo oscuro y salir -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="2" Stroke="{StaticResource Sulley}" StrokeShape="Ellipse">
                    <Image Source="monster.jpg" Aspect="AspectFill" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="LblSaludo" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource Texto}" />
                    <Label x:Name="LblEmpleado" FontSize="12" TextColor="{DynamicResource TextoSuave}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" x:Name="BtnTema" Text="🌙" Clicked="OnTemaClicked" FontSize="18"
                        BackgroundColor="{DynamicResource Tarjeta}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" />
                <Button Grid.Column="3" Text="Salir" Clicked="OnCerrarSesionClicked"
                        BackgroundColor="#A93226" TextColor="White" FontSize="13" FontAttributes="Bold"
                        HeightRequest="40" Padding="14,0" CornerRadius="20" VerticalOptions="Center" />
            </Grid>

            <!-- Tarjeta de bienvenida con la marca -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="130" Padding="18,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B4F8A" Offset="0" />
                        <GradientStop Color="#082E54" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*,Auto">
                    <Label Text="MONSTER · EUREKA BANK" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Mike}" CharacterSpacing="2" />
                    <Label Grid.Row="1" Text="Ventanilla" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Row="2" x:Name="LblSesion" FontSize="12" TextColor="#C8DEF5" />
                </Grid>
            </Border>

            <!-- Accesos: íconos redondos de colores -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Button Text="≡" Clicked="OnMovimientosClicked" BackgroundColor="#0D6EFD" TextColor="White" FontSize="26" FontAttributes="Bold"
                            WidthRequest="62" HeightRequest="62" CornerRadius="18" Padding="0" />
                    <Label Text="Movimientos" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Texto}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Button Text="+" Clicked="OnDepositoClicked" BackgroundColor="#198754" TextColor="White" FontSize="26" FontAttributes="Bold"
                            WidthRequest="62" HeightRequest="62" CornerRadius="18" Padding="0" />
                    <Label Text="Depósito" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Texto}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Button Text="−" Clicked="OnRetiroClicked" BackgroundColor="#C0392B" TextColor="White" FontSize="26" FontAttributes="Bold"
                            WidthRequest="62" HeightRequest="62" CornerRadius="18" Padding="0" />
                    <Label Text="Retiro" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Texto}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="6">
                    <Button Text="⇄" Clicked="OnTransferenciaClicked" BackgroundColor="#6F42C1" TextColor="White" FontSize="24" FontAttributes="Bold"
                            WidthRequest="62" HeightRequest="62" CornerRadius="18" Padding="0" />
                    <Label Text="Transferencia" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource Texto}" />
                </VerticalStackLayout>
            </Grid>

            <Border Padding="16" BackgroundColor="{DynamicResource Tarjeta}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Operaciones de esta sesión" FontAttributes="Bold" TextColor="{DynamicResource Texto}" />
                    <VerticalStackLayout x:Name="ListaSesion" Spacing="4" />
                </VerticalStackLayout>
            </Border>

            <!-- Estado del servidor -->
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Ellipse x:Name="PuntoServidor" WidthRequest="9" HeightRequest="9" Fill="#6C757D" VerticalOptions="Center" />
                <Label x:Name="LblServidor" Text="Comprobando servidor…" FontSize="12" TextColor="{DynamicResource TextoSuave}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
