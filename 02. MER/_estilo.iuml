' Estilo común de todos los diagramas (mismos colores que los clientes).
!pragma layout smetana
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #082E54
skinparam ArrowFontColor #212529
skinparam ActorBorderColor #082E54
skinparam ActorBackgroundColor #E3EEF8
skinparam UsecaseBorderColor #0B4F8A
skinparam UsecaseBackgroundColor #E3EEF8
skinparam RectangleBorderColor #082E54
skinparam PackageBorderColor #082E54
skinparam PackageBackgroundColor #F8FAFD
skinparam ComponentBorderColor #0B4F8A
skinparam ComponentBackgroundColor #E3EEF8
skinparam NodeBorderColor #082E54
skinparam NodeBackgroundColor #F2F5F9
skinparam ClassBorderColor #0B4F8A
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E3EEF8
skinparam NoteBorderColor #C9A227
skinparam NoteBackgroundColor #FFF8DC
skinparam ParticipantBorderColor #0B4F8A
skinparam ParticipantBackgroundColor #E3EEF8
skinparam SequenceLifeLineBorderColor #6C757D
skinparam ActivityBorderColor #0B4F8A
skinparam ActivityBackgroundColor #E3EEF8
skinparam ActivityDiamondBorderColor #082E54
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam PartitionBorderColor #082E54
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
