<?xml version="1.0" encoding="utf-8"?>
<!--
  La carpeta de entrega tiene una ruta muy larga y NuGet no puede descomprimir paquetes con rutas
  de más de 260 caracteres. Por eso los paquetes (Web API y Newtonsoft.Json) se guardan en una
  carpeta corta del usuario: %LOCALAPPDATA%\EUREKA_REST_SERVIDOR\packages. No afecta al código.
-->
<configuration>
  <config>
    <add key="repositoryPath" value="%LOCALAPPDATA%\EUREKA_REST_SERVIDOR\packages" />
  </config>
</configuration>
