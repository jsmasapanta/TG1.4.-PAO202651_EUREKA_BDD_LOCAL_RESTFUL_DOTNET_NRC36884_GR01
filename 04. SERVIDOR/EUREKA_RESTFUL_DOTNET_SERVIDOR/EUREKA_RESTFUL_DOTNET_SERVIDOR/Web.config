<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!--
      SQL Server local (instancia por defecto MSSQLSERVER) con el login monster / monster
      que crea "03. BDD\03_Crea_Login_monster.sql".
      Otras instancias: Data Source=.\SQLEXPRESS   o   Data Source=(localdb)\MSSQLLocalDB
    -->
    <add name="EurekaBank"
         connectionString="Data Source=localhost;Initial Catalog=EUREKABANK;User ID=monster;Password=monster;TrustServerCertificate=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <customErrors mode="On" />
  </system.web>

  <system.webServer>
    <handlers>
      <!-- Web API atiende las rutas sin extensión (api/eurekabank/...) con todos los verbos. -->
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <!-- Página con la lista de operaciones y formularios de prueba. -->
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
