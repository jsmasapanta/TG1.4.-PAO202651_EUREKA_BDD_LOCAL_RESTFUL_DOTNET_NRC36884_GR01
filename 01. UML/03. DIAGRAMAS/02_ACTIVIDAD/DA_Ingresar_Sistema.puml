@startuml DA_Ingresar_Sistema
!include ../_estilo.iuml
title Diagrama de actividad — CU01 Iniciar sesión (los intentos los controla el servidor)

|Empleado|
start
:Abre el cliente;
|Cliente (vista + controlador)|
:Muestra el login y la URL del servidor;
repeat
  |Empleado|
  :Escribe usuario y clave;
  |Cliente (vista + controlador)|
  :Envía login(usuario, clave);
  |Servidor API REST|
  if (¿campos vacíos?) then (sí)
    :HTTP 400 «Ingrese usuario y clave.»;
  elseif (¿usuario bloqueado?) then (sí)
    :HTTP 401 «Usuario bloqueado por superar 3 intentos.\nIntente de nuevo en N segundos.»;
  else (no)
    :SELECT Empleado WHERE vch_emplusuario = @usuario;
    if (¿existe y la clave coincide?) then (sí)
      :Reinicia los intentos del usuario;
      :Devuelve Empleado {Codigo, Usuario, Nombre};
      |Cliente (vista + controlador)|
      :Guarda el empleado de la sesión;
      :Muestra el menú principal;
      stop
    else (no)
      |Servidor API REST|
      :intentos + 1;
      if (¿intentos = 3?) then (sí)
        :Bloquea al usuario 2 minutos;
        :HTTP 401 «Se superaron los 3 intentos.\nEl usuario queda bloqueado 2 minutos.»;
      else (no)
        :HTTP 401 «Usuario o clave incorrectos.\nIntentos restantes: N.»;
      endif
    endif
  endif
  |Cliente (vista + controlador)|
  :Muestra el mensaje del servidor;
repeat while (¿intenta de nuevo?) is (sí) not (no)
stop
@enduml
