@startuml DA_Registrar_Retiro
!include ../_estilo.iuml
title Diagrama de actividad — CU04 Registrar retiro

|Empleado|
start
:Elige "Retiro" en el menú;
:Escribe cuenta e importe;
|Cliente (vista + controlador)|
if (¿cuenta de 8 dígitos e importe > 0\ncon hasta 2 decimales?) then (no)
  :Muestra el error en rojo;
  stop
endif
:Pide confirmación;
|Servidor API REST|
:registrarRetiro(cuenta, importe, codEmpleado);
:BEGIN TRANSACTION;
:SELECT cuenta WITH (UPDLOCK);
if (¿existe y está ACTIVO?) then (no)
  :ROLLBACK;
  :HTTP 409 REGLA_NEGOCIO;
  |Cliente (vista + controlador)|
  :Muestra el mensaje del servidor;
  stop
endif
|Servidor API REST|
if (¿saldo >= importe?) then (no)
  :ROLLBACK;
  :HTTP 409 "Saldo insuficiente";
  |Cliente (vista + controlador)|
  :Muestra el mensaje del servidor;
  stop
endif
|Servidor API REST|
:UPDATE Cuenta (saldo - importe, contador + 1);
:INSERT Movimiento tipo 004 (Retiro);
:COMMIT;
:Devuelve el nuevo saldo;
|Cliente (vista + controlador)|
:Muestra "Retiro registrado" y el nuevo saldo;
stop
@enduml
