@startuml DA_Registrar_Deposito
!include ../_estilo.iuml
title Diagrama de actividad — CU03 Registrar depósito

|Empleado|
start
:Elige "Depósito" en el menú;
:Escribe cuenta e importe;
|Cliente (vista + controlador)|
if (¿cuenta de 8 dígitos e importe > 0\ncon hasta 2 decimales?) then (no)
  :Muestra el error en rojo;
  stop
endif
:Pide confirmación;
|Empleado|
if (¿confirma?) then (no)
  stop
endif
|Servidor API REST|
:registrarDeposito(cuenta, importe, codEmpleado);
:BEGIN TRANSACTION;
:Verifica que el empleado exista;
:SELECT cuenta WITH (UPDLOCK);
if (¿existe y está ACTIVO?) then (no)
  :ROLLBACK;
  :HTTP 409 REGLA_NEGOCIO;
  |Cliente (vista + controlador)|
  :Muestra el mensaje del servidor;
  stop
endif
|Servidor API REST|
:UPDATE Cuenta (saldo + importe, contador + 1);
:INSERT Movimiento tipo 003 (Depósito);
:COMMIT;
:Devuelve el nuevo saldo;
|Cliente (vista + controlador)|
:Muestra "Depósito registrado" y el nuevo saldo;
stop
@enduml
