@startuml DC_Clientes
!include ../_estilo.iuml
title Diagrama de clases — Clientes (MVC + Singleton), ejemplo: escritorio

package "ec.edu.monster.vista" {
  class FormLogin
  class FormPrincipal
  class PanelMovimientos
  class PanelOperacion
  class Formato <<static>> {
    + Dinero(importe) : string
    + Titulo(tipo) : string
    + EsIngreso(movimiento) : bool
    + IntentarLeerImporte(texto, out importe) : bool
    + Monster() : Image
  }
  class Tema <<static>>
}

package "ec.edu.monster.controlador" {
  class ControladorEureka {
    + Empleado : Empleado
    + IniciarSesionAsync(usuario, clave) : Task<Empleado>
    + ConsultarCuentaAsync(cuenta) : Task<Cuenta>
    + TraerMovimientosAsync(cuenta) : Task<Movimiento[]>
    + RegistrarDepositoAsync(cuenta, importe) : Task<decimal>
    + RegistrarRetiroAsync(cuenta, importe) : Task<decimal>
    + RegistrarTransferenciaAsync(origen, destino, importe) : Task<decimal>
    + CerrarSesion()
  }
}

package "ec.edu.monster.servicio" {
  class ClienteEureka <<Singleton>> {
    - {static} _instancia : Lazy<ClienteEureka>
    + {static} Instancia : ClienteEureka
    - _http : HttpClient
    - ClienteEureka()
    + Login(usuario, clave) : Empleado
    + ConsultarCuenta(cuenta) : Cuenta
    + TraerMovimientos(cuenta) : Movimiento[]
    + RegistrarDeposito(cuenta, importe, codEmpleado) : decimal
    + RegistrarRetiro(cuenta, importe, codEmpleado) : decimal
    + RegistrarTransferencia(origen, destino, importe, codEmpleado) : decimal
    - Get<T>(ruta) : T
    - Post<T>(ruta, cuerpo) : T
  }
  class Json <<static>> {
    + Serializar(objeto) : string
    + Deserializar<T>(json) : T
  }
  class ErrorServicioException
}

package "ec.edu.monster.modelo  (solo get/set)" {
  class Empleado {
    + Codigo : string
    + Usuario : string
    + Nombre : string
  }
  class Cuenta {
    + Codigo, Cliente, Moneda, Sucursal : string
    + Saldo : decimal
    + Estado : string
    + FechaCreacion : DateTime
    + NumeroMovimientos : int
  }
  class Movimiento {
    + Numero : int
    + Fecha : DateTime
    + Tipo, Accion : string
    + Importe : decimal
    + Empleado, CuentaReferencia : string
  }
  class ErrorServicio {
    + Codigo : string
    + Mensaje : string
  }
  class SolicitudLogin {
    + Usuario, Clave : string
  }
  class SolicitudMovimiento {
    + Cuenta : string
    + Importe : decimal
    + CodEmpleado : string
  }
  class SolicitudTransferencia {
    + CuentaOrigen, CuentaDestino : string
    + Importe : decimal
    + CodEmpleado : string
  }
  class ResultadoOperacion {
    + Cuenta : string
    + Saldo : decimal
  }
  enum TipoOperacion {
    Deposito
    Retiro
    Transferencia
  }
}

FormLogin --> ControladorEureka
FormPrincipal --> ControladorEureka
FormPrincipal *-- PanelMovimientos
FormPrincipal *-- PanelOperacion
PanelMovimientos --> ControladorEureka
PanelOperacion --> ControladorEureka
PanelMovimientos ..> Formato
PanelOperacion ..> Formato
ControladorEureka --> ClienteEureka : Instancia
ClienteEureka ..> Json
ClienteEureka ..> ErrorServicioException
ErrorServicioException ..> ErrorServicio
ClienteEureka ..> Empleado : JSON
ClienteEureka ..> Cuenta : JSON
ClienteEureka ..> Movimiento : JSON
ClienteEureka ..> SolicitudMovimiento : JSON
ClienteEureka ..> ResultadoOperacion : JSON

note bottom of ClienteEureka
  Sin reglas del banco: el login con 3 intentos y todas
  las validaciones están en el servidor; su mensaje llega
  en el JSON de error {codigo, mensaje} (HTTP 400/401/409).
  Consola: igual (VistaConsola + ControladorConsola).
  Web: ClienteEureka con AddSingleton en Program.cs.
  Móvil: ClienteRest.Instancia (HttpClient + System.Text.Json)
  llena los mismos modelos get/set.
end note
@enduml
