@startuml DC_Servidor
!include ../_estilo.iuml
title Diagrama de clases — Servidor EUREKA_RESTFUL_DOTNET_SERVIDOR

package "ec.edu.monster.ws" {
  class EurekabankController <<ApiController>> {
    <<RoutePrefix api/eurekabank>>
    + Login(SolicitudLogin) : POST login
    + ConsultarCuenta(numero) : GET cuenta
    + TraerMovimientos(cuenta) : GET movimientos
    + RegistrarDeposito(SolicitudMovimiento) : POST deposito
    + RegistrarRetiro(SolicitudMovimiento) : POST retiro
    + RegistrarTransferencia(SolicitudTransferencia) : POST transferencia
    - Ejecutar<T>(operacion, codigoRegla) : IHttpActionResult
    - Error(codigoHttp, codigo, mensaje) : IHttpActionResult
  }
  class WebApiConfig <<static>> {
    + Register(config)
  }
}

package "ec.edu.monster.servicio" {
  class EurekaServicio <<Singleton>> {
    - {static} _instancia : Lazy<EurekaServicio>
    + {static} Instancia : EurekaServicio
    - EurekaServicio(bd)
    + Login(usuario, clave) : Empleado
    + ConsultarCuenta(cuenta) : Cuenta
    + TraerMovimientos(cuenta) : List<Movimiento>
    + RegistrarDeposito(...) : decimal
    + RegistrarRetiro(...) : decimal
    + RegistrarTransferencia(...) : decimal
    - LeerCuentaBloqueada(cn, tx, cuenta)
    - Aplicar(cn, tx, cuenta, variacion, tipo, empleado, referencia) : decimal
  }
  class ReglaNegocioException
  class Validacion <<static>>
}

package "ec.edu.monster.db" {
  class ConexionBD <<Singleton>> {
    - {static} _instancia : Lazy<ConexionBD>
    + {static} Instancia : ConexionBD
    - _cadenaConexion : string
    - ConexionBD()
    + AbrirConexion() : SqlConnection
  }
}

package "ec.edu.monster.modelo" {
  class Empleado <<JSON>> {
    Codigo, Usuario, Nombre
  }
  class Cuenta <<JSON>> {
    Codigo, Cliente, Moneda, Sucursal,
    Saldo, Estado, FechaCreacion, NumeroMovimientos
  }
  class Movimiento <<JSON>> {
    Numero, Fecha, Tipo, Accion,
    Importe, Empleado, CuentaReferencia
  }
  class ErrorServicio <<JSON>> {
    Codigo, Mensaje
  }
  class SolicitudLogin <<JSON>> {
    Usuario, Clave
  }
  class SolicitudMovimiento <<JSON>> {
    Cuenta, Importe, CodEmpleado
  }
  class SolicitudTransferencia <<JSON>> {
    CuentaOrigen, CuentaDestino, Importe, CodEmpleado
  }
  class ResultadoOperacion <<JSON>> {
    Cuenta, Saldo
  }
}

EurekabankController --> EurekaServicio : Instancia
EurekaServicio --> ConexionBD : Instancia
EurekaServicio ..> Validacion
EurekaServicio ..> ReglaNegocioException
EurekaServicio ..> Cuenta
EurekaServicio ..> Movimiento
EurekaServicio ..> Empleado
EurekabankController ..> ErrorServicio
EurekabankController ..> ResultadoOperacion
WebApiConfig ..> EurekabankController : rutas [Route]
@enduml
