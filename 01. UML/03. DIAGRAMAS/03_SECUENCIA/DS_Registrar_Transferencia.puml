@startuml DS_Registrar_Transferencia
!include ../_estilo.iuml
title Diagrama de secuencia — CU05 Registrar transferencia
autonumber

actor Empleado
participant "vista\n(PanelOperacion / Operacion.cshtml /\nOperacionPage)" as Vista
participant "controlador" as Ctrl
participant "servicio\nClienteEureka (Singleton)" as Proxy
participant "ws\nEurekabankController" as WS
participant "servicio\nEurekaServicio (Singleton)" as Neg
participant "db\nConexionBD (Singleton)" as BD
database "SQL Server\nEUREKABANK" as SQL

Empleado -> Vista : origen, destino, importe, Registrar
Vista -> Ctrl : validar formato
Ctrl --> Vista : ok
Vista -> Ctrl : registrar(Transferencia, ...)
Ctrl -> Proxy : RegistrarTransferencia(origen, destino, importe, codEmpleado)
Proxy -> WS : POST api/eurekabank/transferencia (JSON)
WS -> Neg : RegistrarTransferencia(...)
Neg -> BD : AbrirConexion()
BD --> Neg : SqlConnection
Neg -> SQL : BEGIN TRAN; SELECT ... WITH (UPDLOCK) (ambas cuentas)
alt cuentas activas, misma moneda y saldo suficiente
  Neg -> SQL : UPDATE origen / INSERT Movimiento 009
  Neg -> SQL : UPDATE destino / INSERT Movimiento 008
  Neg -> SQL : COMMIT
  Neg --> WS : nuevo saldo origen
  WS --> Proxy : <registrarTransferenciaResult>
  Proxy --> Ctrl : saldo
  Ctrl --> Vista : "Transferencia registrada"
else regla incumplida
  Neg -> SQL : ROLLBACK
  Neg --> WS : ReglaNegocioException
  WS --> Proxy : HTTP 409 ErrorServicio {codigo: REGLA_NEGOCIO, mensaje}
  Proxy --> Ctrl : ErrorServicioException(mensaje)
  Ctrl --> Vista : mensaje en rojo
end
@enduml
