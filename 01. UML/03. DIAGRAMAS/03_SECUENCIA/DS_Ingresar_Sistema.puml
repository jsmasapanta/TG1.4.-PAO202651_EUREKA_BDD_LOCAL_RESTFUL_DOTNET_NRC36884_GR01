@startuml DS_Ingresar_Sistema
!include ../_estilo.iuml
title Diagrama de secuencia — CU01 Iniciar sesión
autonumber

actor Empleado
participant "vista\n(FormLogin / Login.cshtml /\nLoginPage)" as Vista
participant "controlador" as Ctrl
participant "servicio\nClienteEureka (Singleton)" as Proxy
participant "ws\nEurekabankController" as WS
participant "servicio\nEurekaServicio (Singleton)" as Neg
participant "db\nConexionBD (Singleton)" as BD
database "SQL Server\nEUREKABANK" as SQL

Empleado -> Vista : usuario, clave, Ingresar
Vista -> Ctrl : IniciarSesion(usuario, clave)
Ctrl -> Proxy : Login(usuario, clave)
Proxy -> WS : POST api/eurekabank/login {usuario, clave}
WS -> Neg : Login(usuario, clave)
alt usuario bloqueado (3 intentos fallidos hace menos de 2 min)
  Neg --> WS : ReglaNegocioException
  WS --> Proxy : HTTP 401 «Usuario bloqueado por superar 3 intentos…»
  Proxy --> Ctrl : ErrorServicioException(mensaje)
  Ctrl --> Vista : ErrorServicioException
  Vista --> Empleado : mensaje del servidor
else no bloqueado
  Neg -> BD : AbrirConexion()
  BD --> Neg : SqlConnection
  Neg -> SQL : SELECT chr_emplcodigo, vch_emplclave ... FROM Empleado
  SQL --> Neg : fila del empleado
  alt clave correcta
    Neg -> Neg : reinicia los intentos
    Neg --> WS : Empleado
    WS --> Proxy : HTTP 200 {codigo: "0012", usuario, nombre}
    Proxy --> Ctrl : Empleado (modelo get/set)
    Ctrl --> Vista : Empleado
    Vista --> Empleado : menú principal
  else usuario o clave incorrectos
    Neg -> Neg : intentos + 1 (al 3.º bloquea 2 min)
    Neg --> WS : ReglaNegocioException
    WS --> Proxy : HTTP 401 «Usuario o clave incorrectos. Intentos restantes: N.»
    Proxy --> Ctrl : ErrorServicioException(mensaje)
    Ctrl --> Vista : ErrorServicioException
    Vista --> Empleado : mensaje del servidor
  end
end
@enduml
