@startuml DCU_EurekaBank
!include ../_estilo.iuml
title Diagrama de casos de uso — EurekaBank RESTful .NET
left to right direction

actor "Empleado\n(monster)" as Empleado
actor "SQL Server\nEUREKABANK" as BD <<sistema>>

rectangle "API REST api/eurekabank + clientes (consola, escritorio, web, móvil)" {
  usecase "CU01 Iniciar sesión" as CU01
  usecase "CU02 Consultar cuenta\ny movimientos" as CU02
  usecase "CU03 Registrar depósito" as CU03
  usecase "CU04 Registrar retiro" as CU04
  usecase "CU05 Registrar transferencia" as CU05
  usecase "CU06 Cerrar sesión" as CU06
  usecase "CU07 Configurar URL\ndel servidor" as CU07
  usecase "Validar cuenta activa\ny saldo" as VAL
}

Empleado --> CU01
Empleado --> CU02
Empleado --> CU03
Empleado --> CU04
Empleado --> CU05
Empleado --> CU06
Empleado --> CU07
CU04 ..> VAL : <<include>>
CU05 ..> VAL : <<include>>
CU03 ..> CU01 : <<requiere>>
CU01 --> BD
CU02 --> BD
CU03 --> BD
CU04 --> BD
CU05 --> BD
note right of CU07 : solo en el cliente móvil
@enduml
