@model MovimientosViewModel
@{
    ViewData["Title"] = "Movimientos";
}

<div class="tema-consulta">
    <h1 class="titulo">Movimientos de cuenta</h1>
    <p class="ayuda">Escriba el número de cuenta (8 dígitos) y presione Consultar.</p>

    <form asp-action="Movimientos" method="get" class="fila-consulta">
        <input name="cuenta" value="@Model.Cuenta" inputmode="numeric" placeholder="Ej.: 00100001" autofocus autocomplete="off" />
        <button type="submit" class="boton boton-color">CONSULTAR</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="mensaje-error izquierda">@Model.Error</p>
    }

    @if (Model.Datos != null)
    {
        var c = Model.Datos;
        var barras = Formato.Barras(Model.Movimientos);
        decimal maximo = barras.Count == 0 ? 1 : Math.Max(1, barras.Max(b => b.Total));

        @* Tarjeta de la cuenta, como una tarjeta bancaria. *@
        <section class="tarjeta-banco @(c.Estado == "ACTIVO" ? "" : "inactiva")">
            <div class="tb-tipo">CUENTA DE AHORROS · @c.Moneda.ToUpperInvariant()</div>
            <div class="tb-chip"></div>
            <div class="tb-numero">@Formato.NumeroTarjeta(c.Codigo)</div>
            <div class="tb-titular">TITULAR<strong>@c.Cliente.ToUpperInvariant()</strong></div>
            <div class="tb-saldo">SALDO DISPONIBLE<strong>@Formato.Simbolo(c.Moneda) @Formato.Dinero(c.Saldo)</strong></div>
            <div class="tb-pie">@c.Sucursal · @c.Estado · desde @c.FechaCreacion.ToString("MM/yyyy") · <b>MONSTER · EUREKA BANK</b></div>
        </section>

        @if (Model.Movimientos.Count > 0)
        {
            <div class="graficos">
                <section class="tarjeta grafico">
                    <h3>Total por tipo de movimiento</h3>
                    <div class="barras">
                        @foreach (var b in barras)
                        {
                            <div class="barra-col">
                                <span class="barra-valor">@Formato.Dinero(b.Total)</span>
                                <div class="barra-relleno" style="height:@((int)(b.Total / maximo * 100))%; background:@b.Color"></div>
                                <span class="barra-nombre">@b.Tipo</span>
                            </div>
                        }
                    </div>
                </section>
                <section class="tarjeta grafico">
                    <h3>Evolución del saldo <small>(últimos @Math.Min(15, Model.Movimientos.Count) movimientos)</small></h3>
                    @{ string puntos = Formato.PuntosSaldo(c.Saldo, Model.Movimientos, 320, 150); }
                    <svg class="linea-saldo" viewBox="0 0 320 150" preserveAspectRatio="none">
                        <polygon points="6,150 @puntos 314,150" class="area" />
                        <polyline points="@puntos" class="trazo" />
                    </svg>
                    <div class="eje"><span>antes</span><span>hoy: @Formato.Dinero(c.Saldo)</span></div>
                </section>
            </div>
        }

        <div class="tabla-contenedor">
            <table class="tabla">
                <thead>
                    <tr><th>Nro</th><th>Fecha</th><th>Tipo</th><th>Acción</th><th class="derecha">Importe</th><th>Empleado</th><th>Cuenta ref.</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimientos)
                    {
                        <tr>
                            <td>@m.Numero</td>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@m.Tipo</td>
                            <td>@m.Accion</td>
                            <td class="derecha @(Formato.EsIngreso(m) ? "ingreso" : "salida")">@(Formato.EsIngreso(m) ? "+" : "−")@Formato.Dinero(m.Importe)</td>
                            <td>@m.Empleado</td>
                            <td>@m.CuentaReferencia</td>
                        </tr>
                    }
                    @if (Model.Movimientos.Count == 0)
                    {
                        <tr><td colspan="7" class="vacio">La cuenta no tiene movimientos.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
