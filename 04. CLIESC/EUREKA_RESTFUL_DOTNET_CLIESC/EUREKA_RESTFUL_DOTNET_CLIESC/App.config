<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Cambiar SOLO esta dirección para apuntar a otro servidor (en la misma PC: http://localhost:8088). -->
    <add key="UrlServidor" value="http://192.168.100.3:8088" />
  </appSettings>
</configuration>
